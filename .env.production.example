# ============================================================
# Weight Tracker — Production environment variables reference
#
# This file documents every variable required in production.
# It is safe to commit (no real secrets here).
#
# Variables are set in two places:
#   A) Azure Container Apps secrets  → set via infra/provision.sh
#   B) GitHub Actions secrets        → set in repo Settings
# ============================================================


# ============================================================
# A) Azure Container Apps — App container (weight-tracker)
# ============================================================

# Neon serverless PostgreSQL connection string.
# Get this from https://neon.tech after creating your project.
# Format: postgresql+psycopg2://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.eu-central-1.aws.neon.tech/weight_tracker?sslmode=require

# Public-facing base URL of the Keycloak instance.
# Must be reachable from the user's browser.
KEYCLOAK_URL=https://weighttracker-auth.bawada.fr

# Keycloak realm and client (must match realm-export.json)
KEYCLOAK_REALM=weight-tracker
KEYCLOAK_CLIENT_ID=weight-tracker-frontend

# Comma-separated list of allowed CORS origins.
# Must include the app's production domain.
CORS_ORIGINS=https://weighttracker.bawada.fr


# ============================================================
# A) Azure Container Apps — Keycloak container
# ============================================================

# Keycloak admin credentials (set strong values in production)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<strong-password>

# Neon connection string for Keycloak's own database.
# Create a separate Neon database named 'keycloak' for isolation,
# or use the same Neon project with a second database.
# Format: jdbc:postgresql://<host>/keycloak?user=<user>&password=<password>&sslmode=require
KC_DB_URL=jdbc:postgresql://ep-xxx.eu-central-1.aws.neon.tech/keycloak?user=<user>&password=<password>&sslmode=require

# Database credentials used by Keycloak
POSTGRES_USER_KC=<neon-username>
POSTGRES_PASSWORD_KC=<neon-password>

# Keycloak's public hostname (no https://, no trailing slash)
# Container Apps handles TLS termination; KC_PROXY=edge tells Keycloak to trust it.
KC_HOSTNAME=weighttracker-auth.bawada.fr
KC_PROXY=edge
KC_HTTP_ENABLED=true


# ============================================================
# B) GitHub Actions secrets
#    Settings → Secrets and variables → Actions → New secret
# ============================================================

# Azure OIDC federated credentials (no password needed).
# Values printed by infra/provision.sh at end of run.
AZURE_CLIENT_ID=<service-principal-app-id>
AZURE_TENANT_ID=<azure-tenant-id>
AZURE_SUBSCRIPTION_ID=<azure-subscription-id>

# Azure Container Registry login server
ACR_LOGIN_SERVER=weighttrackercr.azurecr.io

# Keycloak connection details baked into the React JS bundle at build time.
# These must match what Keycloak is actually configured with.
VITE_KEYCLOAK_URL=https://weighttracker-auth.bawada.fr
VITE_KEYCLOAK_REALM=weight-tracker
VITE_KEYCLOAK_CLIENT_ID=weight-tracker-frontend
