# ============================================================
# Weight Tracker — Production environment variables reference
#
# This file documents every variable required in production.
# It is safe to commit (no real secrets here).
#
# Variables are set in two places:
#   A) Azure Container Apps secrets  → injected by Terraform (infra/)
#   B) GitHub Actions secrets        → set in repo Settings
# ============================================================


# ============================================================
# A) Azure Container Apps — App container (weight-tracker)
# ============================================================

# PostgreSQL connection string (Azure Flexible Server, private).
# COMPUTED AND INJECTED BY TERRAFORM (see infra/database.tf) — do not
# set by hand. Shown here only to document the format.
# Format: postgresql+psycopg2://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://pgadmin:<generated>@psql-baw-weighttracker-prd.postgres.database.azure.com/weighttracker?sslmode=require

# Public-facing base URL of the Keycloak instance.
# Must be reachable from the user's browser.
KEYCLOAK_URL=https://weighttracker-auth.bawada.fr

# Keycloak realm and client (must match realm-export.json)
KEYCLOAK_REALM=weight-tracker
KEYCLOAK_CLIENT_ID=weight-tracker-frontend

# Comma-separated list of allowed CORS origins.
# Must include the app's production domain.
CORS_ORIGINS=https://weighttracker.bawada.fr


# ============================================================
# A) Azure Container Apps — Keycloak container
# ============================================================

# Keycloak admin credentials (set strong values in production)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<strong-password>

# JDBC connection string for Keycloak's own database.
# COMPUTED AND INJECTED BY TERRAFORM (see infra/database.tf) — do not
# set by hand. Keycloak uses the 'keycloak' database on the same
# private Flexible Server as the app.
# Format: jdbc:postgresql://<host>/keycloak?sslmode=require
KC_DB_URL=jdbc:postgresql://psql-baw-weighttracker-prd.postgres.database.azure.com/keycloak?sslmode=require

# Database credentials used by Keycloak — injected by Terraform.
KC_DB_USERNAME=pgadmin
KC_DB_PASSWORD=<generated>

# Keycloak's public hostname (no https://, no trailing slash)
# Container Apps handles TLS termination; KC_PROXY=edge tells Keycloak to trust it.
KC_HOSTNAME=weighttracker-auth.bawada.fr
KC_PROXY=edge
KC_HTTP_ENABLED=true

# Google identity provider.
#
# These are NOT Container App env vars. The IdP configuration lives in
# Keycloak's own Postgres database, so it is a one-shot operation that
# survives restarts and new revisions — there is nothing to inject at
# container startup, and no Terraform change is needed.
#
# The two vars below are only needed in the shell from which you run
# docker/keycloak/configure-google-idp.sh. Since the Keycloak ingress is
# public, that can be your local Keycloak container pointed at prod:
#
#   docker compose exec \
#     -e KEYCLOAK_URL=https://weighttracker-auth.bawada.fr \
#     -e KEYCLOAK_ADMIN_PASSWORD='<prod-admin-password>' \
#     keycloak /opt/keycloak/bin/configure-google-idp.sh
#
# The authorised redirect URI declared in Google Cloud Console must be:
#   https://weighttracker-auth.bawada.fr/realms/weight-tracker/broker/google/endpoint
GOOGLE_CLIENT_ID=58232596528-2nh6sa8053pcl3c6uj7qtii4vcra6lsq.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<from-google-cloud-console>


# ============================================================
# B) GitHub Actions secrets
#    Settings → Secrets and variables → Actions → New secret
# ============================================================

# Azure OIDC federated credentials (no password needed).
# Values printed by `terraform output github_actions_secrets`.
AZURE_CLIENT_ID=<service-principal-app-id>
AZURE_TENANT_ID=<azure-tenant-id>
AZURE_SUBSCRIPTION_ID=<azure-subscription-id>

# Azure Container Registry login server
ACR_LOGIN_SERVER=crbawweighttrackerprd.azurecr.io

# Keycloak connection details baked into the React JS bundle at build time.
# These must match what Keycloak is actually configured with.
VITE_KEYCLOAK_URL=https://weighttracker-auth.bawada.fr
VITE_KEYCLOAK_REALM=weight-tracker
VITE_KEYCLOAK_CLIENT_ID=weight-tracker-frontend
